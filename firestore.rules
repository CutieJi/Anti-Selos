rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /antiSelosAccounts/{accountHash} {

      // Only authenticated users can access an account.
      // Direct document lookup only; no collection listing.
      allow get: if request.auth != null;

      allow list: if false;

      // Create new accounts.
      allow create: if request.auth != null
        && accountHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll([
          'selosCount',
          'agreementAccepted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'selosCount',
          'agreementAccepted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.selosCount == 0
        && request.resource.data.agreementAccepted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update account counters and agreement state only.
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'selosCount',
          'agreementAccepted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.selosCount is int
        && request.resource.data.selosCount >= resource.data.selosCount
        && request.resource.data.selosCount <= 100000
        && request.resource.data.agreementAccepted is bool
        && (
          request.resource.data.agreementAccepted == true
          || resource.data.agreementAccepted == false
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'selosCount',
            'agreementAccepted',
            'updatedAt'
          ]);

      // Accounts cannot be deleted through the client.
      allow delete: if false;

      match /messages/{messageId} {

        function accountExists() {
          return exists(
            /databases/$(database)/documents/antiSelosAccounts/$(accountHash)
          );
        }

        // Message reads are scoped to signed-in users and existing accounts.
        allow get, list: if request.auth != null
          && accountHash.matches('^[0-9a-f]{64}$')
          && accountExists();

        // Messages are immutable once posted.
        allow create: if request.auth != null
          && accountHash.matches('^[0-9a-f]{64}$')
          && accountExists()
          && request.resource.data.keys().hasAll([
            'text',
            'senderId',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'text',
            'senderId',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
